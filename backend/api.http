# Requisicoes para testar a API com a extensao REST Client do VS Code.
# Rode npm run dev e clique em "Send Request" em cima de cada uma.
# Os ids batem com o banco recem criado pelo npm run db:reset.

@api = http://localhost:3000/api
@amanha = {{$localDatetime "YYYY-MM-DD" 1 d}}
@daquiTresDias = {{$localDatetime "YYYY-MM-DD" 3 d}}

### Servidor no ar
GET {{api}}/saude


#################### LOGIN ####################

### Login do usuario de teste (rode antes das rotas com token)
# @name loginUsuario
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "usuario@teste.com",
  "senha": "senha123"
}

### Login do voluntario de teste
# @name loginVoluntario
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "voluntario@teste.com",
  "senha": "senha123"
}

### Login com senha errada (401)
POST {{api}}/auth/login
Content-Type: application/json

{
  "email": "usuario@teste.com",
  "senha": "errada"
}

### Cadastro de usuario
POST {{api}}/auth/cadastro
Content-Type: application/json

{
  "nome": "Mariam Diallo",
  "email": "mariam@email.com",
  "senha": "minhasenha",
  "telefone": "11912345678",
  "perfil": "usuario",
  "pais_origem": "Guiné",
  "idioma": "fr",
  "aceite_lgpd": true
}

### Cadastro de voluntario
POST {{api}}/auth/cadastro
Content-Type: application/json

{
  "nome": "Paula Ventura",
  "email": "paula@email.com",
  "senha": "minhasenha",
  "perfil": "voluntario",
  "aceite_lgpd": true,
  "voluntario": {
    "area_id": 2,
    "registro_profissional": "CRP 06/111111",
    "idiomas": ["pt", "es"],
    "bio": "Psicóloga com experiência em atendimento a migrantes."
  }
}

### Cadastro sem aceitar a LGPD (400)
POST {{api}}/auth/cadastro
Content-Type: application/json

{
  "nome": "Teste",
  "email": "teste@email.com",
  "senha": "123456",
  "perfil": "usuario",
  "aceite_lgpd": false
}


#################### MEU PERFIL (precisa de token) ####################

### Meus dados (usa o token do loginUsuario)
GET {{api}}/me
Authorization: Bearer {{loginUsuario.response.body.$.token}}

### Meus dados como voluntario
GET {{api}}/me
Authorization: Bearer {{loginVoluntario.response.body.$.token}}

### Editar meus dados
PUT {{api}}/me
Authorization: Bearer {{loginUsuario.response.body.$.token}}
Content-Type: application/json

{
  "telefone": "11900001111"
}

### Sem token (401)
GET {{api}}/me


#################### AREAS ####################

### Listar areas
GET {{api}}/areas

### Uma area
GET {{api}}/areas/1

### Criar area
POST {{api}}/areas
Content-Type: application/json

{
  "nome": "Tradução de documentos"
}

### Editar area (id 13 e a criada acima)
PUT {{api}}/areas/13
Content-Type: application/json

{
  "nome": "Tradução e interpretação"
}

### Excluir area
DELETE {{api}}/areas/13

### Excluir area com voluntarios (409)
DELETE {{api}}/areas/1


#################### USUARIOS ####################

### Listar todos
GET {{api}}/usuarios

### So quem tem perfil usuario
GET {{api}}/usuarios?perfil=usuario

### Um usuario (o 6 e voluntario e vem com os dados profissionais)
GET {{api}}/usuarios/6

### Editar usuario
PUT {{api}}/usuarios/2
Content-Type: application/json

{
  "pais_origem": "Haiti",
  "idioma": "ht"
}

### Excluir usuario (libera os horarios que ele tinha reservado)
DELETE {{api}}/usuarios/5
