PORT=3000
JWT_SECRET=troque-este-valor
CORS_ORIGIN=http://localhost:5173

# endereço do Postgres. No Supabase: botão Connect, a URI do Transaction pooler, com a senha do banco
# no lugar de [YOUR-PASSWORD]. Um Postgres na própria máquina também serve:
# postgresql://postgres:postgres@localhost:5432/acolhimento
DATABASE_URL=

# videochamada com Google Meet (opcional): sem estas chaves o agendamento funciona sem link
# como preencher: README, seção Videochamada
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# true manda o convite por e-mail para o usuário e o voluntário (deixe false com os e-mails de teste)
GOOGLE_ENVIAR_CONVITES=false
