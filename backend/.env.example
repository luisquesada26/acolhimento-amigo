PORT=3000
JWT_SECRET=troque-este-valor
CORS_ORIGIN=http://localhost:5173

# endereço do banco do site (Supabase): o Luis passa em particular. Nunca no GitHub.
# Cuidado: é o banco de verdade. O que você grava rodando o npm run dev fica no site.
DATABASE_URL=

# videochamada com Google Meet (opcional): sem estas chaves o agendamento funciona sem link
# como preencher: README, seção Videochamada
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# true manda o convite por e-mail para o usuário e o voluntário (deixe false com os e-mails de teste)
GOOGLE_ENVIAR_CONVITES=false

# tradução da bio e dos serviços pelo MyMemory (opcional, gratuito e sem chave): README, seção Tradução
# com um e-mail de contato, o limite sobe de 5 mil para 50 mil caracteres por dia
TRADUCAO_EMAIL=
# 1 desliga a tradução: tudo aparece como foi escrito
TRADUCAO_DESLIGADA=
# só para testes: o endereço de um tradutor falso no formato do MyMemory
TRADUCAO_URL=
