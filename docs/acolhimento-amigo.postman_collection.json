{
  "info": {
    "name": "Acolhimento Amigo",
    "description": "API do Acolhimento Amigo. Rode npm run db:reset e npm run dev antes. Rode primeiro os dois logins da pasta Login: o token fica salvo e as rotas de Meu perfil usam ele sozinhas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// datas no formato AAAA-MM-DD a partir de hoje, para os horarios nunca ficarem no passado",
          "{",
          "  const diaMais = (dias) => {",
          "    const d = new Date();",
          "    d.setDate(d.getDate() + dias);",
          "    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;",
          "  };",
          "  pm.collectionVariables.set('amanha', diaMais(1));",
          "  pm.collectionVariables.set('daquiTresDias', diaMais(3));",
          "}"
        ]
      }
    }
  ],
