{
  "info": {
    "_postman_id": "d8f4e7b0-6ff3-44f8-82ca-e306756559f6",
    "name": "Acolhimento Amigo",
    "description": "Todas as rotas da API, com GET, POST, PUT e DELETE de cada tabela.\n\nNão precisa fazer login: antes de cada envio a coleção entra sozinha com os usuários de teste (usuario@teste.com e voluntario@teste.com) e guarda os tokens.\n\nPUT e DELETE trabalham em cima do que o POST da mesma pasta criou. Se você mandar um PUT ou DELETE antes, a coleção cria o item na hora. Assim nenhum dado do seed é apagado.\n\nAntes de usar: a API precisa estar no ar (`npm run dev` na raiz do projeto). Se o banco foi resetado e alguma requisição der 401 ou 404, é só mandar de novo: a coleção limpa o que ficou velho e prepara outra vez.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "{",
          "  // A coleção entra sozinha com os usuários de teste e cria na hora o que o PUT e o DELETE precisam.",
          "  // Só prepara o que a requisição usa: o token do cabeçalho e os {{ids}} da URL ou do corpo.",
          "  const variaveis = pm.collectionVariables;",
          "  const api = pm.variables.get(\"api\");",
          "  const texto = [pm.request.url.toString(), JSON.stringify(pm.request.headers.toObject()), pm.request.body ? pm.request.body.toString() : \"\"].join(\" \");",
          "  const usa = (nome) => texto.includes(\"{{\" + nome + \"}}\");",
          "",
          "  // anota o que esta requisição usa: se a resposta vier 401 ou 404, o teste da coleção limpa para o próximo envio preparar de novo",
          "  pm.variables.set(\"variaveisDaRequisicao\", [\"tokenUsuario\", \"tokenVoluntario\", \"tokenNovaConta\", \"tokenNovoVoluntario\", \"areaId\", \"servicoId\", \"horarioId\", \"agendamentoId\"].filter(usa).join(\",\"));",
          "",
          "  // data e hora novas a cada envio, para o horário criado não bater com outro",
          "  const sorteio = (min, max) => min + Math.floor(Math.random() * (max - min + 1));",
          "  const diaMais = (dias) => {",
          "    const d = new Date();",
          "    d.setDate(d.getDate() + dias);",
          "    return d.getFullYear() + \"-\" + String(d.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(d.getDate()).padStart(2, \"0\");",
          "  };",
          "  const hora = (minutos) => String(Math.floor(minutos / 60)).padStart(2, \"0\") + \":\" + String(minutos % 60).padStart(2, \"0\");",
          "  const inicio = sorteio(14, 38) * 30;",
          "  variaveis.set(\"dataLivre\", diaMais(sorteio(20, 80)));",
          "  variaveis.set(\"horaInicio\", hora(inicio));",
          "  variaveis.set(\"horaFim\", hora(inicio + 30));",
          "  variaveis.set(\"sufixo\", String(Date.now()).slice(-6));",
          "  variaveis.set(\"emailNovo\", \"conta\" + Date.now() + \"@teste.local\");",
          "",
          "  const enviar = (metodo, caminho, token, corpo, depois) => pm.sendRequest({",
          "    url: api + caminho,",
          "    method: metodo,",
          "    header: Object.assign({ \"Content-Type\": \"application/json\" }, token ? { Authorization: \"Bearer \" + variaveis.get(token) } : {}),",
          "    body: corpo ? { mode: \"raw\", raw: JSON.stringify(corpo) } : undefined,",
          "  }, (erro, res) => {",
          "    let json = null;",
          "    try { json = res.json(); } catch (e) { json = null; }",
          "    depois(erro ? null : json);",
          "  });",
          "",
          "  const conta = (perfil) => Object.assign({",
          "    nome: perfil === \"voluntario\" ? \"Voluntário de Teste\" : \"Usuário de Teste\",",
          "    email: \"conta\" + Date.now() + sorteio(100, 999) + \"@teste.local\",",
          "    senha: \"senha123\",",
          "    perfil,",
          "    aceite_lgpd: true,",
          "  }, perfil === \"voluntario\" ? { voluntario: { area_id: 2 } } : {});",
          "",
          "  // horário livre e serviço do Rafael (voluntário 1), lidos de novo a cada envio",
          "  const buscarLivre = (pronto) => enviar(\"GET\", \"/voluntarios/1\", null, null, (r) => {",
          "    if (!r || !r.horarios || !r.horarios.length || !r.servicos || !r.servicos.length) return pronto(null);",
          "    variaveis.set(\"servicoLivreId\", String(r.servicos[0].id));",
          "    pronto(r.horarios[0].id);",
          "  });",
          "",
          "  const receitas = {",
          "    tokenUsuario: { criar: (pronto) => enviar(\"POST\", \"/auth/login\", null, { email: \"usuario@teste.com\", senha: \"senha123\" }, (r) => pronto(r && r.token)) },",
          "    tokenVoluntario: { criar: (pronto) => enviar(\"POST\", \"/auth/login\", null, { email: \"voluntario@teste.com\", senha: \"senha123\" }, (r) => pronto(r && r.token)) },",
          "    tokenNovaConta: { criar: (pronto) => enviar(\"POST\", \"/auth/cadastro\", null, conta(\"usuario\"), (r) => pronto(r && r.token)) },",
          "    tokenNovoVoluntario: { criar: (pronto) => enviar(\"POST\", \"/auth/cadastro\", null, conta(\"voluntario\"), (r) => pronto(r && r.token)) },",
          "    areaId: {",
          "      precisa: [\"tokenVoluntario\"],",
          "      criar: (pronto) => enviar(\"POST\", \"/areas\", \"tokenVoluntario\", { nome: \"Área de teste \" + variaveis.get(\"sufixo\") }, (r) => pronto(r && r.id)),",
          "    },",
          "    servicoId: {",
          "      precisa: [\"tokenVoluntario\"],",
          "      criar: (pronto) => enviar(\"POST\", \"/servicos\", \"tokenVoluntario\", { titulo: \"Serviço de teste\", descricao: \"Serviço criado pela coleção do Postman.\", duracao_min: 30 }, (r) => pronto(r && r.id)),",
          "    },",
          "    horarioId: {",
          "      precisa: [\"tokenVoluntario\"],",
          "      criar: (pronto) => enviar(\"POST\", \"/horarios\", \"tokenVoluntario\", { data: variaveis.get(\"dataLivre\"), hora_inicio: variaveis.get(\"horaInicio\"), hora_fim: variaveis.get(\"horaFim\") }, (r) => pronto(r && r.id)),",
          "    },",
          "    horarioLivreId: { sempre: true, criar: buscarLivre },",
          "    // reaproveita o agendamento que a coleção já criou, para não encher a agenda do Rafael a cada envio",
          "    agendamentoId: {",
          "      precisa: [\"tokenUsuario\"],",
          "      criar: (pronto) => enviar(\"GET\", \"/meus-agendamentos?status=confirmado\", \"tokenUsuario\", null, (lista) => {",
          "        const daColecao = (lista || []).find((a) => String(a.descricao).startsWith(\"Teste pelo Postman\"));",
          "        if (daColecao) return pronto(daColecao.id);",
          "        buscarLivre((horarioId) => {",
          "          if (!horarioId) return pronto(null);",
          "          enviar(\"POST\", \"/agendamentos\", \"tokenUsuario\", {",
          "            horario_id: Number(horarioId),",
          "            servico_id: Number(variaveis.get(\"servicoLivreId\")),",
          "            descricao: \"Teste pelo Postman: preciso entender como renovar meu protocolo de refúgio.\",",
          "          }, (r) => pronto(r && r.id));",
          "        });",
          "      }),",
          "    },",
          "  };",
          "",
          "  const feitos = {};",
          "  const garantir = (nomes, fim) => {",
          "    const nome = nomes.find((n) => !feitos[n] && (receitas[n].sempre || !variaveis.get(n)));",
          "    if (!nome) return fim();",
          "    const receita = receitas[nome];",
          "    garantir(receita.precisa || [], () => receita.criar((valor) => {",
          "      feitos[nome] = true;",
          "      if (valor === null || valor === undefined) {",
          "        return console.warn(\"Não deu para preparar \" + nome + \". A API está no ar? O banco foi resetado?\");",
          "      }",
          "      variaveis.set(nome, String(valor));",
          "      garantir(nomes, fim);",
          "    }));",
          "  };",
          "",
          "  const nomes = Object.keys(receitas).filter((n) => usa(n) || (n === \"horarioLivreId\" && usa(\"servicoLivreId\")));",
          "  garantir(nomes, () => {});",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "{",
          "  // token ou id que não vale mais (banco resetado, conta ou item excluído): limpa para o próximo envio preparar de novo",
          "  const codigo = pm.response.code;",
          "  if (codigo === 401 || codigo === 404) {",
          "    (pm.variables.get(\"variaveisDaRequisicao\") || \"\").split(\",\").filter(Boolean).forEach((n) => pm.collectionVariables.unset(n));",
          "  }",
          "  pm.test(\"Resposta \" + codigo, () => pm.expect(codigo).to.be.below(400));",
          "}"
        ]
      }
    }
  ],
